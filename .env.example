# Operational Database Simulation & CDC Configuration

# Path to the source transactional database
DATABASE_PATH=data/source_oltp.db

# Directory where extracted CDC JSON payloads are written
CDC_BUFFER_DIR=data/cdc_buffer

# File tracking the high-water mark sequence or timestamp for extraction
CDC_STATE_FILE=data/cdc_state.json

# Interval (in seconds) between simulator database write mutations
SIMULATOR_INTERVAL_SECONDS=5

# Optional seed for random transaction generations (set to integer for determinism)
SIMULATOR_RANDOM_SEED=42

# Databricks Target Integration Credentials
DATABRICKS_HOST=https://adb-7474645859205897.azuredatabricks.net
DATABRICKS_TOKEN=your_personal_access_token_here
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=main
